{
	"name": "@labdigital/toolkit",
	"version": "0.2.0",
	"description": "A set of utilities for building typescript applications",
	"type": "module",
	"module": "./dist/index.js",
	"require": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"require": "./dist/index.cjs",
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"keywords": [],
	"author": "Lab Digital <opensource@labdigital.nl>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/labd/js-toolkit"
	},
	"packageManager": "pnpm@12.12.1",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"generate-docs": "ts-readme",
		"publish:ci": "pnpm build && pnpm changeset publish",
		"test": "vitest run",
		"test:ci": "vitest run --coverage",
		"tsc": "tsc --noEmit",
		"format": "biome check --fix",
		"lint": "biome check",
		"check": "biome check && tsc --noEmit"
	},
	"files": [
		"dist",
		"src"
	],
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@changesets/cli": "^3.0.3",
		"@types/node": "26.6.5",
		"@vitest/coverage-v8": "5.0.3",
		"ts-readme": "^1.1.3",
		"tsdown": "0.23.1",
		"typescript": "^7.0.2",
		"vitest": "5.0.3"
	}
}
